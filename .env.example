# PostgreSQL
DATABASE_URL=postgres://unlockme:unlockme@localhost:5432/unlockme
# 公開URL（メール内リンク・OGPに使用）
APP_URL=http://localhost:3000
# セッション署名などに使用する秘密値（本番では必ず変更）
APP_SECRET=change-me-to-a-long-random-string
# cron / worker エンドポイント保護用
CRON_SECRET=change-me

# 決済: mock | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# メール: log | smtp
MAIL_PROVIDER=log
SMTP_URL=
MAIL_FROM="UNLOCK ME <no-reply@example.com>"
